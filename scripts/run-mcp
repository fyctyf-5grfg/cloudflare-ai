#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
WORKSPACE="${WORKSPACE:-$(cd "$SCRIPT_DIR/.." && pwd)}"
pkill -f "fastmcp" 2>/dev/null
cd "$WORKSPACE"

[ -x /tmp/venv/bin/python ] || python3 -m venv /tmp/venv
/tmp/venv/bin/python -c "import fastmcp" 2>/dev/null || /tmp/venv/bin/pip install --quiet fastmcp
PYTHON="/tmp/venv/bin/python"

$PYTHON - <<'PY' > /tmp/mcp_server.log 2>&1 &
import base64
import json
import os
import signal
import socket
import subprocess as s
import time
import urllib.error
import urllib.request
import uuid

from fastmcp import FastMCP

mcp = FastMCP("Tools")

SKILLS_REPO = os.environ.get("SKILLS_REPO", "fyctyf-5grfg/cloudflare-ai-skills")
GH_TOKEN = os.environ.get("GH_PAT", "")

def gh_req(path, method="GET", payload=None):
    url = f"https://api.github.com{path}"
    data = __import__("json").dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("User-Agent", "mcp-skills")
    if GH_TOKEN:
        req.add_header("Authorization", f"Bearer {GH_TOKEN}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = r.read().decode("utf-8", "replace")
            return r.status, (__import__("json").loads(body) if body.strip().startswith(("{", "[")) else body)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        return e.code, (__import__("json").loads(body) if body.strip().startswith(("{", "[")) else body)

def skill_desc(name):
    st, d = gh_req(f"/repos/{SKILLS_REPO}/contents/skills/{name}/SKILL.md")
    if st != 200 or not isinstance(d, dict):
        return ""
    txt = base64.b64decode(d.get("content", "")).decode("utf-8", "replace")
    for line in txt.splitlines():
        if line.lower().startswith("description:"):
            return line.split(":", 1)[1].strip()
    return ""

@mcp.tool()
def list_skills() -> str:
    """List all skills available in the persistent skills repo (name + description)."""
    st, d = gh_req(f"/repos/{SKILLS_REPO}/contents/skills")
    if st != 200 or not isinstance(d, list):
        return f"error: {d}"
    out = []
    for item in d:
        if item.get("type") != "dir":
            continue
        name = item["name"]
        out.append(f"- {name}: {skill_desc(name)}")
    return "\n".join(out) or "(no skills yet — create one with save_skill)"

@mcp.tool()
def read_skill(name: str) -> str:
    """Read the full markdown content of a skill by name."""
    st, d = gh_req(f"/repos/{SKILLS_REPO}/contents/skills/{name}/SKILL.md")
    if st != 200:
        return f"error: {d}"
    return base64.b64decode(d["content"]).decode("utf-8", "replace")

@mcp.tool()
def save_skill(name: str, content: str) -> str:
    """Create or update a skill named `name` with markdown `content`. Use a short kebab-case name and start content with frontmatter: ---\\nname: <name>\\ndescription: <one line>\\n---"""
    path = f"/repos/{SKILLS_REPO}/contents/skills/{name}/SKILL.md"
    payload = {"message": f"save skill {name} (via cloudflare-ai)", "content": base64.b64encode(content.encode()).decode()}
    st, d = gh_req(path)
    if st == 200 and isinstance(d, dict):
        payload["sha"] = d.get("sha")
    st2, d2 = gh_req(path, "PUT", payload)
    return "saved" if st2 in (200, 201) else f"error: {d2}"

@mcp.tool()
def delete_skill(name: str) -> str:
    """Delete a skill by name."""
    path = f"/repos/{SKILLS_REPO}/contents/skills/{name}/SKILL.md"
    st, d = gh_req(path)
    if st != 200:
        return f"error: {d}"
    st2, d2 = gh_req(path, "DELETE", {"message": f"delete skill {name} (via cloudflare-ai)", "sha": d["sha"]})
    return "deleted" if st2 == 200 else f"error: {d2}"

@mcp.tool()
def read_file(path: str) -> str:
    return open(path).read() if os.path.exists(path) else "Not found"

@mcp.tool()
def list_files(path: str = ".") -> str:
    return "\n".join(os.listdir(path))

@mcp.tool()
def execute(command: str) -> str:
    r = s.run(command, shell=True, capture_output=True, text=True)
    return f"Exit {r.returncode}\n{r.stdout}\n{r.stderr}"

@mcp.tool()
def write_file(path: str, content: str) -> str:
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(path, "w") as f:
        f.write(content)
    return f"wrote {len(content)} bytes to {path}"

@mcp.tool()
def web_fetch(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": "mcp-tools/1.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = r.read(500_000)
    charset = r.headers.get_content_charset() or "utf-8"
    return data.decode(charset, "replace")

@mcp.tool()
def run_background(command: str) -> str:
    """Start a long-running command detached from the conversation; returns pid + log path (read the log with read_file, manage with list_background / kill_process)."""
    log = f"/tmp/bg-{uuid.uuid4().hex[:8]}.log"
    p = s.Popen(f"{{ {command}; }} >{log} 2>&1", shell=True)
    try:
        jobs = json.loads(open(BG_JOBS).read()) if os.path.exists(BG_JOBS) else {}
    except Exception:
        jobs = {}
    jobs[str(p.pid)] = {"command": command, "log": log, "started": time.time()}
    json.dump(jobs, open(BG_JOBS, "w"))
    return f"started pid {p.pid}, log: {log}"

BG_JOBS = "/tmp/mcp_bg_jobs.json"

@mcp.tool()
def list_background() -> str:
    """List background jobs started with run_background: pid, running state, command, log path and last log lines."""
    if not os.path.exists(BG_JOBS):
        return "(no background jobs started)"
    try:
        jobs = json.loads(open(BG_JOBS).read())
    except Exception:
        return "(no background jobs)"
    lines = []
    for pid, info in sorted(jobs.items(), key=lambda kv: kv[1].get("started", 0)):
        alive = os.path.exists(f"/proc/{pid}")
        try:
            tail = open(info["log"], errors="replace").read()[-300:]
        except Exception:
            tail = "(no log yet)"
        lines.append(f"pid {pid} [{'running' if alive else 'exited'}] {info['command']}\n  log: {info['log']}\n  tail: {tail!r}")
    return "\n".join(lines) or "(none)"

@mcp.tool()
def kill_process(pid: int) -> str:
    """Force-kill a process by pid (e.g. a background job started with run_background)."""
    try:
        os.kill(pid, signal.SIGKILL)
        return f"killed {pid}"
    except ProcessLookupError:
        return f"pid {pid} not running"
    except PermissionError as e:
        return f"error: {e}"

@mcp.tool()
def edit_file(path: str, old_text: str, new_text: str, replace_all: bool = False) -> str:
    """Surgical file edit: replace exact `old_text` with `new_text`. Default replaces the first occurrence; replace_all=true replaces every occurrence. Fails if old_text is not found."""
    if not os.path.exists(path):
        return f"error: {path} not found"
    txt = open(path).read()
    n = txt.count(old_text)
    if n == 0:
        return f"error: old_text not found in {path}"
    txt = txt.replace(old_text, new_text) if replace_all else txt.replace(old_text, new_text, 1)
    open(path, "w").write(txt)
    return f"replaced {'all %d' % n if replace_all else 'first of %d' % n} occurrence(s) in {path}"

def git(path, *args):
    r = s.run(["git", "-C", path, *args], capture_output=True, text=True)
    return r.returncode, (r.stdout + r.stderr).strip()

@mcp.tool()
def git_clone(repo: str, path: str = "") -> str:
    """Clone a GitHub repo — pass 'owner/name' or a full URL. Returns the local path; the clone gets a pushable authenticated remote (GH_PAT) and a bot identity."""
    if repo.startswith("http"):
        url = repo.rstrip("/")
        name = url.split("/")[-1].removesuffix(".git")
    else:
        url = f"https://github.com/{repo}.git"
        name = repo.split("/")[-1]
    target = os.path.abspath(path or f"/tmp/repos/{name}")
    if os.path.exists(target):
        return f"error: {target} already exists (pull instead: git -C {target} pull)"
    token_part = f"x-access-token:{GH_TOKEN}@" if GH_TOKEN else ""
    authed = url.replace("https://", f"https://{token_part}")
    r = s.run(["git", "clone", authed, target], capture_output=True, text=True)
    if r.returncode != 0:
        return f"error: {(r.stdout + r.stderr).strip()[:500]}"
    git(target, "config", "user.email", "bot@cloudflare-ai")
    git(target, "config", "user.name", "cloudflare-ai")
    git(target, "remote", "set-url", "origin", authed)
    return f"cloned to {target}"

@mcp.tool()
def git_commit_push(path: str, message: str, branch: str = "") -> str:
    """In the git repo at `path`: stage all changes, commit with `message`, push to origin (GH_PAT-authenticated). Optional `branch` pushes HEAD to that branch name."""
    code, out = git(path, "rev-parse", "--is-inside-work-tree")
    if code != 0:
        return f"error: {path} is not a git repo"
    git(path, "add", "-A")
    code, out = git(path, "commit", "-m", message)
    if code != 0 and "nothing to commit" not in out:
        return f"error: {out[:500]}"
    code, out = git(path, "push", "origin", f"HEAD:{branch}" if branch else "HEAD")
    if code != 0:
        return f"error: {out[:500]}"
    code, out = git(path, "log", "-1", "--oneline")
    return f"pushed: {out}"

@mcp.tool()
def http(url: str, method: str = "GET", headers: dict = None, body: str = "") -> str:
    """Generic HTTP request (any method, headers dict, raw string body — body defaults Content-Type to application/json). Returns 'HTTP <status>' + up to 500 KB of response text. 4xx/5xx responses are returned, not raised."""
    data = body.encode() if body else None
    req = urllib.request.Request(url, data=data, method=method.upper())
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    if body and "Content-Type" not in (headers or {}):
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return f"HTTP {r.status}\n" + r.read(500_000).decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code}\n" + e.read(500_000).decode("utf-8", "replace")

@mcp.tool()
def wait_for(target: str, timeout_s: int = 60) -> str:
    """Block until `target` is reachable: an http(s) URL (any HTTP answer counts, even 4xx/5xx) or 'host:port' (TCP connect). Returns elapsed time or an error after timeout."""
    start = time.time()
    is_url = target.startswith("http")
    if not is_url and ":" not in target:
        return "error: pass an http(s) URL or host:port"
    while time.time() - start < timeout_s:
        try:
            if is_url:
                urllib.request.urlopen(target, timeout=5)
                return f"up after {time.time()-start:.0f}s"
            host, port = target.rsplit(":", 1)
            with socket.create_connection((host, int(port)), timeout=3):
                return f"up after {time.time()-start:.0f}s"
        except urllib.error.HTTPError:
            return f"up after {time.time()-start:.0f}s (server answered with HTTP error)"
        except Exception:
            time.sleep(2)
    return f"error: {target} not reachable within {timeout_s}s"

mcp.run(transport="streamable-http", host="0.0.0.0", port=8000, path="/mcp")
PY
MCP_PID=$!

for i in $(seq 1 10); do
    if curl -s -o /dev/null http://localhost:8000/mcp 2>/dev/null; then
        echo "MCP server started (pid $MCP_PID)"
        break
    fi
    if ! kill -0 $MCP_PID 2>/dev/null; then
        echo "MCP server crashed:"
        cat /tmp/mcp_server.log
        exit 1
    fi
    sleep 1
done

cat /tmp/mcp_server.log
